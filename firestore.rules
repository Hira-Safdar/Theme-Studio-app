rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ad_impressions/{doc} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /ad_clicks/{doc} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /rewarded_completions/{doc} {
      allow write: if true;
      allow read: if request.auth != null;
    }
  }
}
